{
  "name": "fitbit-metrics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "node scripts/build.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && node scripts/check-ascii.mjs",
    "check": "npm run typecheck && npm run lint && vitest run",
    "cf-typegen": "wrangler types",
    "fmt": "prettier --write .",
    "pre-commit": "prettier --write . && wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.23",
    "hono": "^4.13.19",
    "marked": "^17.0.4"
  }
}
